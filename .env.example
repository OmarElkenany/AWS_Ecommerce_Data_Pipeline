# Copy this file to .env and fill in your values. .env is git-ignored.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=aws-ecommerce-data-omar-2026
S3_PREFIX=raw/ecommerce
OUTPUT_DIR=ecommerce_data

# Used by the Airflow DAG
GLUE_JOB_NAME=ecommerce-transformation
GLUE_IAM_ROLE=AWSGlueServiceRole-Ecommerce
